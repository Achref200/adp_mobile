PORT=8080
DATABASE_URL=postgres://adp:change-me@localhost:5432/adp
# Keep false outside local SQLite-only development. The API must use PostgreSQL in production.
ALLOW_SQLITE_FALLBACK=false
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-character-secret
EPASS_SIGNING_SECRET=replace-with-a-third-at-least-32-character-secret
APP_ORIGIN=http://localhost:3000
MOBILE_RETURN_URL=https://app.djerbaproject.fr/payment-return
HELLOASSO_ENVIRONMENT=sandbox
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_WEBHOOK_SECRET=
HELLOASSO_ORGANIZATION_SLUG=
HELLOASSO_DONATION_FORM_URL=

# Google Sign-In: OAuth Web client ID (audience check for idTokens).
GOOGLE_CLIENT_ID=
