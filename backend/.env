PORT=8080

# Default SQLite dev DB. For production, set DATABASE_URL to your PostgreSQL connection string.
DATABASE_URL=sqlite:./data/adp.db

# JWT secrets — override these in your deployment platform env settings.
JWT_ACCESS_SECRET=replace-with-a-random-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-a-random-32-char-refresh-secret

# e-Pass signing key — override in production.
EPASS_SIGNING_SECRET=replace-with-a-random-secret-for-epass-hmac

# HelloAsso — set in production. Leave empty to disable payment routes.
# HELLOASSO_ACCESS_TOKEN=
# HELLOASSO_DONATION_FORM_URL=

# Optional outgoing email (SMTP). Leave empty to disable transactional email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
