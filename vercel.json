{
  "version": 2,
  "buildCommand": "echo 'Static deployment: Flutter web build and backend dist are committed'",
  "outputDirectory": "build/web",
  "functions": {
    "api/index.js": {
      "includeFiles": "../backend/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}